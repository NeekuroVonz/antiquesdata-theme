# Copy this file to `.env` in the same folder as `style.css` and fill in values.
# The theme loads `.env` automatically. Never commit `.env`.

# External MySQL (product catalog)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Stripe (use pk_test_ / sk_test_ for local testing)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# One-time site access (amount in smallest currency unit, e.g. cents for USD)
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_PRICE_CENTS=2000

# Membership gate — development / staging only:
# Open the entire site with no login or payment (public listings).
ANTIQUES_BYPASS_MEMBERSHIP=0
# Logged-in users see all content without paying Stripe (still need an account).
ANTIQUES_BYPASS_SUBSCRIPTION=0
